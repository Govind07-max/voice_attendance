# Supabase Configuration
# Copy this file to .env and fill in your project values.
# Supabase Dashboard > Project Settings > API
#
# Use the PUBLISHABLE (anon) key here — never the secret/service-role key.
# The publishable key is safe to ship in the app because RLS protects the data.

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
